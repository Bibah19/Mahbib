# ============================================================
# Copy this file to `.env.local` and fill in what you need.
# Local development works without these settings: reservations are
# saved under data/blob-local/ when Blob credentials are absent.
# Production requires Vercel Blob credentials; email is optional.
# ============================================================

# --- Automatic invitation emails (optional) ------------------
# Create a free account at https://resend.com, verify a sender,
# then paste the API key here. EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM="Weddings <invites@yourdomain.com>"

# --- Private admin page (recommended) ------------------------
# Protects /admin and the admin API. Pick any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=

# --- Vercel Blob ---------------------------------------------
# Connect a PRIVATE Blob store to the Vercel project for deployment.
# To use that store locally, copy its token into .env.local (never commit it).
# Leave empty for separate local development reservations.
BLOB_READ_WRITE_TOKEN=
