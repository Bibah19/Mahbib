# ============================================================
# Copy this file to `.env.local` and fill in what you need.
# DATABASE_URL is required (locally and in production); email is optional.
# ============================================================

# --- Automatic invitation emails (optional) ------------------
# Create a free account at https://resend.com, verify a sender,
# then paste the API key here. EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM="Weddings <invites@yourdomain.com>"

# --- Private admin page (recommended) ------------------------
# Protects /admin and the admin API. Pick any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=

# --- Postgres database ---------------------------------------
# Reservations are stored in Postgres. The table is created automatically.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
